{
  "name": "baby-food-backend",
  "version": "1.0.0",
  "description": "Dynamic Baby Food CMS Backend",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:tools": "npm --prefix ../frontend/tools/baby-milestone-tracker run build",
    "prestart": "npm run build:tools",
    "start": "node server.js",
    "dev": "npm run build:tools && nodemon server.js",
    "seed": "node seed.js",
    "seed:pantry": "node seedPantryIngredients.js",
    "seed:fingerfoods": "node seedFingerFoods.js"
  },
  "keywords": [
    "baby-food",
    "cms"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1042.0",
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^10.0.9",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.32.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
