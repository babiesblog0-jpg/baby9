# Copy this file to .env locally, or paste these keys into your hosting
# provider's Environment Variables settings (e.g. Render). Never commit a
# real .env file — it is gitignored on purpose.

PORT=5005
NODE_ENV=production

# Neon Postgres connection string
DATABASE_URL=

# Auth
JWT_SECRET=
JWT_EXPIRE=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (image storage)
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# Google Gemini AI (AI Recipe Mixer)
GEMINI_API_KEY=
